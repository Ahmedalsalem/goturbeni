NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by sitemap.ts/robots.ts to build absolute URLs. Falls back to
# http://localhost:3000 in local dev if unset.
NEXT_PUBLIC_SITE_URL=

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). gtag is omitted
# entirely when unset, so this is safe to leave blank in local dev.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web Push (VAPID). Generate a keypair with `npx web-push generate-vapid-keys`
# — it's free, no third-party account needed. Public key is sent to the
# browser (NEXT_PUBLIC_), private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Sentry — hata izleme. DSN, proje ayarlarında Client Keys (DSN) altında.
# SENTRY_AUTH_TOKEN yalnızca build sırasında source map yüklemek için
# gerekir (Sentry → Settings → Auth Tokens, project:releases + org:read izni).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Twilio Verify — SMS/OTP telefon doğrulaması (supabase/config.toml →
# [auth.sms.twilio_verify]). Yalnızca yerel `supabase start` için; canlı
# projede Supabase Dashboard → Authentication → Providers → Phone'dan girilir.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_VERIFY_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Upstash Redis — shared rate-limit state across serverless instances
# (src/lib/rate-limit.ts). Free tier at https://console.upstash.com, REST
# URL/token under a database's "REST API" tab. REQUIRED in production —
# the app throws at startup without these; dev/test fall back to an
# in-memory limiter when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — e-posta bildirimi (src/lib/email.ts), push notification'ın
# tamamlayıcısı (kullanıcı siteyi açık tutmuyorsa mesaj/rezervasyon
# bildirimlerini kaçırabiliyordu). Ücretsiz katman: https://resend.com —
# API key Dashboard → API Keys'ten, RESEND_FROM_EMAIL doğrulanmış bir
# domain/adres olmalı. İkisi de boşsa no-op'a düşer (push/VAPID ile aynı desen).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
