# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code agent worktrees
/.claude/worktrees

# typescript
*.tsbuildinfo
next-env.d.ts

# tesseract.js (src/lib/ocr.ts) would cache downloaded language data at the
# project root by default — not expected anymore now that ocr.ts passes
# cacheMethod: "none" and a vendored langPath, but ignored defensively.
# assets/tesseract-lang/ (the vendored copy) is intentionally NOT excluded.
/*.traineddata

.vercel
.env*
